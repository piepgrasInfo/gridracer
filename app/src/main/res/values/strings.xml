    <!-- How to play: the caption shown beside each frame of a walkthrough, one resource per
         frame. The names are what tools/tutorial-editor/codegen.py derives from a project id
         ("how_to_play_", the project id, "_caption_", the frame number), so a generated
         walkthrough and a hand-written one draw their captions from the same resources. -->
    <string name="how_to_play_velocity_rule_caption_1">Your car starts at rest.</string>
    <string name="how_to_play_velocity_rule_caption_2">You haven\'t moved yet, so the coast is your current position.</string>
    <string name="how_to_play_velocity_rule_caption_3">Choose any of the 9 marked positions.</string>
    <string name="how_to_play_velocity_rule_caption_4">You drive to the selected position.</string>
    <string name="how_to_play_velocity_rule_caption_5">Your new coast is determined by your current speed — one grid point ahead.</string>
    <string name="how_to_play_velocity_rule_caption_6">Choose any of the 9 marked positions.</string>
    <string name="how_to_play_velocity_rule_caption_7">You drive to the selected position.</string>

    <string name="how_to_play_wall_crash_caption_1">Your coast projects toward the wall.</string>
    <string name="how_to_play_wall_crash_caption_2">Green points are legal; dim points would cross the wall.</string>
    <string name="how_to_play_wall_crash_caption_3">You brake and steer to (4,2), but the new coast still crosses the wall.</string>
    <string name="how_to_play_wall_crash_caption_4">You crash into the wall and are out of the race.</string>

    <string name="how_to_play_finish_line_caption_1">The finish line is ahead. Its arrow shows the direction you must cross it in.</string>
    <string name="how_to_play_finish_line_caption_2">All nine points are offered as usual. The three beyond the line would cross it the right way.</string>
    <string name="how_to_play_finish_line_caption_3">You cross the line: one lap done. The lap counter in your status frame ticks up.</string>
    <string name="how_to_play_finish_line_caption_4">Later you come back toward the line, heading against its arrow.</string>
    <string name="how_to_play_finish_line_caption_5">The points beyond the line are still offered, but crossing against the arrow is a crash.</string>
    <string name="how_to_play_finish_line_caption_6">You cross the wrong way, burn out on the line, and are out of the race.</string>

    <string name="how_to_play_oil_spill_caption_1">The dark patch ahead is an oil spill, and your coast point lies right on it.</string>
    <string name="how_to_play_oil_spill_caption_2">Oil does not block you: all nine points are offered as usual. You keep your speed and take the coast.</string>
    <string name="how_to_play_oil_spill_caption_3">You are on the oil. Driving through it costs you your steering on the next move.</string>
    <string name="how_to_play_oil_spill_caption_4">Only your coast point and two random points beside it are offered. The other six are withheld.</string>
    <string name="how_to_play_oil_spill_caption_5">You take one of the three and skid there. A spill is a loss of control, not a crash.</string>
    <string name="how_to_play_oil_spill_caption_6">That move touched no oil, so all nine points are offered again.</string>

    <string name="how_to_play_nails_caption_1">The orange patch ahead is a strip of nails, and your coast point lies on it.</string>
    <string name="how_to_play_nails_caption_2">Nails do not block you: all nine points are offered as usual. You keep your speed and take the coast.</string>
    <string name="how_to_play_nails_caption_3">You are on the nails. Driving over them forces a slow-down on your next move.</string>
    <string name="how_to_play_nails_caption_4">At speed, only the three hardest-braking points are offered: the three nearest your car.</string>
    <string name="how_to_play_nails_caption_5">You brake to speed one. That move started on the nails, so they act once more.</string>
    <string name="how_to_play_nails_caption_6">At speed one you may stop, roll straight on, or move to either side, but not accelerate.</string>
    <string name="how_to_play_nails_caption_7">You roll on, clear of the nails.</string>
    <string name="how_to_play_nails_caption_8">That move touched no nails, so all nine points are offered again.</string>

