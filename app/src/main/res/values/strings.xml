    <string name="legal_disclaimer_title">Terms of use</string>
    <string name="legal_disclaimer_body">Grid Racer is provided “as is”, to the extent permitted by applicable law. Your settings, leaderboard and custom tracks are kept on this device only.</string>
    <string name="legal_disclaimer_read_full">Privacy Policy &amp; Terms</string>
    <string name="legal_disclaimer_storage_note">Custom tracks live on this device and are not backed up anywhere. Uninstalling the app deletes them.</string>
    <string name="legal_disclaimer_privacy_note">Privacy: no analytics, no ads, no account. Local play keeps everything on this device. If you join or host an online multiplayer race, your player name, chosen moves and the current race state are sent to the server you connect to; this data is only used to run the race and is not stored permanently.</string>
    <string name="legal_disclaimer_checkbox">I have read and accept the Privacy Policy and Terms of Service</string>
    <string name="legal_disclaimer_continue">Continue</string>

    <string name="crash_consent_title">Crash reporting</string>
    <string name="crash_consent_body">You can help improve Grid Racer by sending anonymous crash reports. A report is sent only after the app actually crashes or freezes, and only if you turn it on below. It contains the error, the device model and the Android version, so the problem can be found and fixed.</string>
    <string name="crash_consent_permission_note">Turning this on enables network communication and uses the Internet permission. Your custom tracks, player names and race results are never included in a crash report and are never transmitted.</string>
    <string name="crash_consent_change_later">You can change this choice at any time in Settings. The default is off, so no information leaves your device unless you explicitly agree.</string>
    <string name="crash_consent_toggle">Send crash reports</string>
    <string name="crash_consent_continue">Continue</string>

