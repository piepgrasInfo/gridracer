    <!-- Permissions screen (ui/PermissionsScreen.kt, legal/AppPermissions.kt). Wording matches legal/permissions.md. -->
    <string name="permissions_intro">Grid Racer requests two permissions and deliberately avoids several others - here\'s exactly what each one does, and whether your device has granted it.</string>
    <string name="permissions_never_title">Not needed</string>
    <string name="permission_status_granted">Granted</string>
    <string name="permission_status_denied">Denied</string>
    <string name="permission_status_not_requested">Not requested</string>
    <string name="permission_grant_install_time">Granted when you installed the app. Android does not list it among the permissions you can switch off.</string>
    <string name="permission_grant_runtime_granted">You allowed this.</string>
    <string name="permission_grant_runtime_denied">You have not allowed this.</string>
    <string name="permission_grant_notifications_on">Notifications are switched on for this app.</string>
    <string name="permission_grant_notifications_off">Notifications are switched off for this app.</string>
    <string name="permission_grant_never_requested">Grid Racer never asks for it, so it can never be given</string>
    <string name="permission_tap_to_revoke">Tap to revoke in Android settings</string>
    <string name="permission_tap_to_allow">Tap to allow in Android settings</string>
    <string name="permission_notifications_title">Notifications</string>
    <string name="permission_notifications_body">Used to tell you it is your turn in an online race while Grid Racer is in the background. Nothing else is ever posted, and declining it changes nothing about the game itself.</string>
    <string name="permission_notifications_granted">Grid Racer may notify you when it is your turn.</string>
    <string name="permission_notifications_denied">Turned off, so you will not be told when it is your turn in an online race.</string>
    <string name="permission_internet_title">Internet access</string>
    <string name="permission_internet_body">Used for online multiplayer races and, only when you turn it on in Settings, for sending crash reports to Bugsink. Multiplayer needs a network connection; crash reporting is off by default and the game works exactly the same without it.</string>
    <string name="permission_internet_granted">Given automatically when you install the app. Android does not list it among the permissions you can switch, so there is nothing to turn off here.</string>
    <string name="permission_internal_broadcasts_title">Internal broadcast protection</string>
    <string name="permission_internal_broadcasts_body">Not something we ask for: the Android build tools generate it for the app and grant it only to the app itself, so that receivers registered at runtime cannot be triggered by other apps. It grants no access to anything and is not visible to you as a capability.</string>
    <string name="permission_internal_broadcasts_granted">Granted at install, and usable only by Grid Racer itself.</string>
    <string name="permission_camera_title">Camera</string>
    <string name="permission_camera_body">Grid Racer has no need for your camera and never requests access to it.</string>
    <string name="permission_microphone_title">Microphone</string>
    <string name="permission_microphone_body">Grid Racer has no need for your microphone and never requests access to it.</string>
    <string name="permission_location_title">Location</string>
    <string name="permission_location_body">Grid Racer has no need for your location and never requests access to it.</string>
    <string name="permission_contacts_title">Contacts</string>
    <string name="permission_contacts_body">Grid Racer has no need for your contacts and never requests access to them.</string>

