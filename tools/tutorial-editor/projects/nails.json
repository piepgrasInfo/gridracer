  "frames": [
    {
      "phase": 0,
      "caption": "The orange patch ahead is a strip of nails, and your coast point lies on it."
    },
    {
      "phase": 0.12,
      "caption": "Driving onto nails..."
    },
    {
      "phase": 0.36,
      "caption": "At speed, only the three hardest-braking points are offered: the three nearest your car."
    },
    {
      "phase": 0.48,
      "caption": "You have to break. That move started on the nails, so they act once more."
    },
    {
      "phase": 0.6,
      "caption": "At speed one you are restricted to the four nearest points."
    },
    {
      "phase": 0.72,
      "caption": "You drive on, clear of the nails."
    },
    {
      "phase": 0.85,
      "caption": "That move touched no nails, so all nine points are available again."
    }
